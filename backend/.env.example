# FocusFlow Environment Variables
# Copy this file to .env and update the values

SECRET_KEY=your-secret-key-here
DEBUG=True

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=focusflow

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION_HOURS=24

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Gemini API key - powers the AI coach chat endpoint.
# Optional: without it, /api/insights/chat returns 503 and the rest of the app works normally.
GEMINI_API_KEY=

# Demo user seeding (local development only - leave false in production)
SEED_DEMO_USER=false
DEMO_USER_EMAIL=demo@focusflow.local
DEMO_USER_PASSWORD=changeme123
